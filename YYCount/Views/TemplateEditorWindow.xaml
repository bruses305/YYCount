<Window x:Class="YYCount.Views.TemplateEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:YYCount.Infrastructure"
        Title="Редактор шаблона Excel" Height="200" Width="650"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    
    <Window.Resources>
        <local:BooleanToColorConverter x:Key="BooleanToColorConverter"/>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Строка пути и кнопки -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="Путь к шаблону:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox Text="{Binding TemplatePath, UpdateSourceTrigger=PropertyChanged}" Width="350" Margin="0,0,10,0"/>
            <Button Content="Обзор..." Command="{Binding BrowseCommand}" Padding="10,5" Margin="0,0,5,0"/>
            <Button Content="Проверить" Command="{Binding CheckCommand}" Padding="10,5"/>
        </StackPanel>

        <!-- Список тегов (кликабельные кнопки) -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="Доступные теги:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ItemsControl ItemsSource="{Binding Tags}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding DataContext.CopyTagCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                CommandParameter="{Binding TagName}"
                                Margin="0,0,10,0" 
                                Padding="2,0"
                                Background="Transparent" 
                                BorderThickness="0"
                                Cursor="Hand">
                            <Button.Content>
                                <TextBlock Text="{Binding TagName}" 
                                           Foreground="{Binding IsFound, Converter={StaticResource BooleanToColorConverter}, 
                                           ConverterParameter=DarkGreen, FallbackValue=Black}"/>
                            </Button.Content>
                            <Button.ToolTip>
                                <TextBlock Text="Нажмите, чтобы скопировать тег"/>
                            </Button.ToolTip>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- Сообщение о копировании (появляется на секунду) -->
        <TextBlock Grid.Row="2" Text="{Binding CopyMessage}" Foreground="Green" 
                   HorizontalAlignment="Center" Margin="0,0,0,10" Visibility="{Binding CopyMessage, Converter={StaticResource StringToVisibilityConverter}}"/>

        <!-- Кнопки сохранения/отмены -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Сохранить" Command="{Binding SaveCommand}" Padding="15,5" Margin="0,0,10,0" IsDefault="True"/>
            <Button Content="Отмена" Command="{Binding CancelCommand}" Padding="15,5" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>