<Window x:Class="YYCount.Views.TemplateEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактор шаблона Excel" Height="220" Width="550"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- Путь к шаблону -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Путь к шаблону:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox Text="{Binding TemplatePath}" Width="300" Margin="0,0,10,0"/>
            <Button Content="Обзор..." Command="{Binding BrowseCommand}" Padding="10,5"/>
        </StackPanel>

        <!-- Настройки строки и столбца -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Строка начала таблицы:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox Text="{Binding StartRow}" Width="50" Margin="0,0,20,0"/>
            <TextBlock Text="Столбец условных установок (номер):" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox Text="{Binding UnitColumn}" Width="50" Margin="0,0,20,0"/>
            <TextBlock Text="(по умолчанию: 33 и 17)" VerticalAlignment="Center" Foreground="Gray" FontSize="11"/>
        </StackPanel>

        <!-- Подсказка -->
        <TextBlock Grid.Row="2" Text="* Столбец 1 = A, 2 = B, ... 17 = Q" Foreground="Gray" FontSize="11" Margin="0,0,0,10"/>

        <!-- Кнопки -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Сохранить" Command="{Binding SaveCommand}" Padding="15,5" Margin="0,0,10,0" IsDefault="True"/>
            <Button Content="Отмена" Command="{Binding CancelCommand}" Padding="15,5" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>