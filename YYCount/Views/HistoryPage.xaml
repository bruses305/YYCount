<Page x:Class="YYCount.Views.HistoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="История расчётов">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="White" Padding="10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Создать Новый расчёт" Command="{Binding CreateNewCommand}" Margin="0,0,10,0" Padding="10,5"/>
                <Button Content="Шаблон" Command="{Binding OpenTemplateEditorCommand}" Margin="0,0,10,0" Padding="10,5"/>
                <Button Content="О программе"  Command="{Binding OpenAboutCommand}" Padding="10,5"/>
            </StackPanel>
        </Border>

        <ListBox Grid.Row="1" ItemsSource="{Binding Calculations}" Margin="0,10,0,0">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="ContextMenu">
                        <Setter.Value>
                            <ContextMenu>
                                <MenuItem Header="Открыть" 
                                          Command="{Binding DataContext.OpenCalculationCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                          CommandParameter="{Binding}"/>
                                <MenuItem Header="Удалить" 
                                          Command="{Binding DataContext.DeleteCalculationCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                          CommandParameter="{Binding}"/>
                            </ContextMenu>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="Gray" BorderThickness="1" Margin="0,5" Padding="5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14"/>
                                <TextBlock Text="{Binding Date, StringFormat={}{0:dd.MM.yyyy HH:mm}}"/>
                                <TextBlock Text="{Binding TotalSum, StringFormat='Итого: {0:F2} у.е.'}"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Открыть" 
                                    Command="{Binding DataContext.OpenCalculationCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                    CommandParameter="{Binding}" VerticalAlignment="Center" Margin="5,0"/>
                            <Button Grid.Column="2" Content="Удалить" 
                                    Command="{Binding DataContext.DeleteCalculationCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                    CommandParameter="{Binding}" VerticalAlignment="Center" Margin="5,0"
                                    Background="LightCoral"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Page>