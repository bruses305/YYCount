<Window x:Class="YYCount.Views.EquipmentEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактор справочника оборудования" Height="400" Width="500"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- Форма добавления/редактирования -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Название:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox Text="{Binding NewName}" Width="150" Margin="0,0,10,0"/>
            <TextBlock Text="Усл. за ед.:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox Text="{Binding NewUnitValue}" Width="60" Margin="0,0,10,0"/>
            <Button Content="Добавить" Command="{Binding AddCommand}" Margin="0,0,5,0"/>
            <Button Content="Изменить" Command="{Binding EditCommand}"/>
        </StackPanel>
        <!-- Список -->
        <ListBox Grid.Row="1" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" 
                 DisplayMemberPath="Name" Margin="0,0,0,10"/>
        <!-- Кнопки удаления и сохранения -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Удалить" Command="{Binding DeleteCommand}" Margin="0,0,10,0"/>
            <Button Content="Сохранить" Command="{Binding SaveCommand}" Margin="0,0,10,0" IsDefault="True"/>
            <Button Content="Отмена" Command="{Binding CancelCommand}" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>