<Page x:Class="YYCount.Views.CalculationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Редактор расчёта">
    <Page.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCalculationCommand}"/>
    </Page.InputBindings>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Название расчёта:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox Text="{Binding CalculationName, UpdateSourceTrigger=PropertyChanged}" Width="200"/>
            <TextBlock Text="{Binding CalculationDate, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Margin="20,0,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="LightGray" BorderThickness="1" Padding="5" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Оборудование:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <Button Content="{Binding SelectedEquipmentName}" Command="{Binding OpenSelectorCommand}" 
                        Width="150" Margin="0,0,10,0" HorizontalContentAlignment="Left"/>
                <TextBlock Text="Количество:" Margin="10,0,5,0" VerticalAlignment="Center"/>
                <TextBox x:Name="QuantityTextBox" Text="{Binding QuantityToAddText, UpdateSourceTrigger=PropertyChanged}" 
                         Width="60" Margin="0,0,10,0" KeyDown="QuantityTextBox_KeyDown"/>
                <Button Content="Добавить" Command="{Binding AddPositionCommand}" Margin="0"/>
                <Button Content="Редактировать справочник" Command="{Binding EditEquipmentCommand}" Margin="10,0,0,0"/>
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="2" ItemsSource="{Binding Positions}" AutoGenerateColumns="False" 
                  CanUserAddRows="False" CanUserDeleteRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="№" Binding="{Binding Id}" Width="40" IsReadOnly="True"/>
                <DataGridTextColumn Header="Наименование" Binding="{Binding EquipmentName, UpdateSourceTrigger=PropertyChanged}" Width="*" IsReadOnly="False"/>
                <DataGridTextColumn Header="Количество" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="100" IsReadOnly="False"/>
                <DataGridTextColumn Header="Усл. за ед." Binding="{Binding UnitValue, UpdateSourceTrigger=PropertyChanged}" Width="100" IsReadOnly="False"/>
                <DataGridTextColumn Header="Итого" Binding="{Binding Total, StringFormat={}{0:F2}}" Width="100" IsReadOnly="True"/>
                <DataGridTemplateColumn Header="Действия" Width="60">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="X" Command="{Binding DataContext.RemovePositionCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                    CommandParameter="{Binding}" Background="LightCoral"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3" Background="LightYellow" Padding="5" Margin="0,10">
            <TextBlock Text="{Binding TotalSum, StringFormat=Общая сумма условных установок: {0:F2}}" 
                       FontWeight="Bold" FontSize="16"/>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10">
            <Button Content="Экспорт в Excel" Command="{Binding ExportToExcelCommand}" Padding="15,5" Margin="0,0,10,0"/>
            <Button Content="Сохранить" Command="{Binding SaveCalculationCommand}" Padding="15,5" Margin="0,0,10,0"/>
            <Button Content="Отмена" Command="{Binding CancelCommand}" Padding="15,5"/>
        </StackPanel>
    </Grid>
</Page>